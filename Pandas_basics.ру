Знакомство с таблицей (pandas) =====

# --- Подключение библиотеки ---
# import подключает библиотеку, as pd даёт ей короткое имя (так принято везде)
import pandas as pd

# --- Загрузка данных ---
# read_csv читает csv-файл и превращает его в таблицу DataFrame
# df - переменная, куда сохраняем таблицу
df = pd.read_csv('modaflow_dataset_base.csv')

# DataFrame: строки = объекты (заказы), столбцы = признаки

# --- Первые строки ---
df.head()      # первые 5 строк
df.head(7)     # первые 7 строк (число в скобках = аргумент)

# --- Последние строки ---
# проверяем, что файл загрузился полностью и в конце нет мусора
df.tail()      # последние 5 строк
df.tail(2)     # последние 2 строки

# --- Размер таблицы ---
df.shape       # (строки, столбцы), БЕЗ скобок после shape
len(df)        # только количество строк

# --- Названия столбцов ---
df.columns     # какие есть признаки и как называется целевая переменная

# ===== Датасет ModaFlow =====
# price                   цена товара в рублях
# delivery_days           срок доставки в днях
# customer_purchases      общее число покупок клиента
# customer_purchase_freq  частота покупок клиента
# category_encoded        категория: 0 Платье, 1 Куртка, 2 Джинсы,
#                                    3 Обувь, 4 Свитер, 5 Футболка
# size_encoded            размер: 0 S, 1 M, 2 L, 3 XL
# purchased               ЦЕЛЕВАЯ переменная: 0 не куплен, 1 куплен
# Остальные столбцы = признаки, по ним модель делает предсказание

# ===== Памятка =====
# head() и tail() - функции, у них есть скобки
# shape и columns - готовая информация, скобок нет
# Первым делом с новым файлом: head(), tail(), shape, columns
