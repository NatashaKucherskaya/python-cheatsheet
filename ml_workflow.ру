# ===== УРОК 6. Как обучить модель: путь от данных к модели =====

# --- 6 этапов любой ML-задачи ---
# 1. Подготовка данных    выделяем признаки (X) и цель (y)
# 2. Деление на выборки   обучающая (учимся) и тестовая (проверяем)
# 3. Выбор модели         выбираем алгоритм, создаём объект модели
# 4. Обучение             модель ищет закономерности между X и y
# 5. Предсказание         модель отвечает на новых данных
# 6. Оценка качества      сравниваем предсказания с правильными ответами

# ===== ПОЛНЫЙ КОД (ModaFlow) =====
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score

df = pd.read_csv('modaflow_dataset_base.csv')

# --- ШАГ 1. Подготовка данных ---
# X (features) = признаки, всё, что модель ВИДИТ
# y (target)   = правильные ответы, которые нужно предсказать
X = df[['price',
        'delivery_days',
        'customer_purchases',
        'customer_purchase_freq',
        'category_encoded',
        'size_encoded']]   # двойные скобки [[...]]: передаём СПИСОК столбцов
y = df['purchased']        # 0 не выкупил, 1 выкупил

# --- ШАГ 2. Деление на обучающую и тестовую выборки ---
# train: на ней модель учится
# test: на ней проверяем, чего модель НЕ видела
# Зачем: если проверять на тех же данных, модель просто запомнит ответы
#        (как ученик, который вызубрил задачи, но не понял принцип)
X_train, X_test, y_train, y_test = train_test_split(
    X, y,              # что делим
    test_size=0.2,     # 20% на тест, 80% на обучение (классика 80/20)
    random_state=42    # фиксируем случайность, результат повторяется
)

# --- ШАГ 3. Выбор модели ---
# DecisionTreeClassifier = дерево решений
# Задаёт последовательность простых вопросов о признаках
# (например: цена меньше 3000? доставка больше 7 дней?)
# Структуру вопросов дерево строит САМО при обучении
model = DecisionTreeClassifier(
    max_depth=5,       # максимум 5 вопросов подряд, защита от переобучения
    random_state=42
)
# model пока только создана, она ещё НЕ обучена

# --- ШАГ 4. Обучение ---
# fit = обучить. Передаём признаки и правильные ответы
model.fit(X_train, y_train)

# --- ШАГ 5. Предсказания ---
# predict получает только признаки (X_test), ответов y_test НЕ видит
# Результат: 0 (не выкупит) или 1 (выкупит) для каждого заказа
predictions = model.predict(X_test)

# --- ШАГ 6. Оценка качества ---
# accuracy = доля правильных предсказаний
# Пример: 65 верных из 100 = 0.65 = 65%
accuracy = accuracy_score(y_test, predictions)
print(accuracy)

# --- ШАГ 7. Интерпретация результата ---
# Всего 3992 заказа: ~3193 в обучении (80%), ~799 в тесте (20%)
# Точность 57,32%: верно угадано около 570 из 1000 заказов
# Лучше случайного угадывания (50%), но для бизнеса слабо
# В e-commerce полезной считается точность от 75% и выше
